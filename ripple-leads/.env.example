# Copy this file to .env and fill in only what you actually want to use.
# The app runs with ALL of these blank: OSM discovery, scoring, manual
# enrichment and .eml/CSV draft export need no keys at all.

# --- Enrichment + email drafting (optional, cheap) ---
# Get a key at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Google Places discovery (optional, paid, OFF by default) ---
# Only used when discovery.use_google_places is true in config.yaml
GOOGLE_PLACES_API_KEY=

# --- Notion CRM push (optional, OFF by default) ---
# Internal integration token from https://www.notion.so/my-integrations
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Gmail drafts/send (optional, OFF by default) ---
# Path to the OAuth client file downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
