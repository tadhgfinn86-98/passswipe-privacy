# Copy to .env and fill in. Never commit the real file.
# Load with:  set -a && source .env && set +a

# Companies House (free, register at
# https://developer.company-information.service.gov.uk/).
# Without this, every lead is treated as an individual subscriber under PECR
# and routed to the call list rather than the email queue.
COMPANIES_HOUSE_API_KEY=

# Google Places API (paid per request; set a billing cap in Google Cloud).
# Optional. Without it there is no phone/website/review enrichment.
GOOGLE_PLACES_API_KEY=

# Airtable (optional, for --push airtable)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# Notion (optional, for --push notion)
NOTION_TOKEN=
NOTION_DATABASE_ID=
