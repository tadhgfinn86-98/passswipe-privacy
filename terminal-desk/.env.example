# Terminal Desk configuration. Copy to .env and fill in what you have.
# Every key is optional — the House Desk engine runs with none of them.
# A key exported in your shell always wins over this file.

# --- Equities Agents (virattt/ai-hedge-fund) -------------------------------
# Prices, fundamentals and earnings. https://financialdatasets.ai
FINANCIAL_DATASETS_API_KEY=

# --- LLM providers --------------------------------------------------------
# Any ONE of these powers the investor personas and the crypto DAG's
# position calls. ai-market-maker specifically wants OpenAI or Atlas Cloud.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ATLASCLOUD_API_KEY=

# --- Exchange -------------------------------------------------------------
# Only needed for LIVE crypto trading. Backtests use public market data.
# Leave blank unless you mean it.
BINANCE_API_KEY=
BINANCE_API_SECRET=
